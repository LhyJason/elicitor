# Site settings for the Slurm scripts. Copy to cluster/local.env (untracked) and fill in.
SLURM_ACCOUNT=your_account
SLURM_PARTITION=your_gpu_partition
# Modules to load; leave empty if python3.12 and ollama are already on PATH.
PYTHON_MODULE=python/3.12
OLLAMA_MODULE=ollama
# Where Ollama finds its models (a shared read-only folder works; see serve_ollama.sh).
OLLAMA_MODELS=$HOME/.ollama/models
